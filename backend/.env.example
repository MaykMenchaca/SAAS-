# POS System Backend Configuration
# Copy this file to .env and adjust values

SECRET_KEY=cambiar-en-produccion-usar-valor-aleatorio
JWT_SECRET_KEY=cambiar-en-produccion-usar-valor-aleatorio
DATABASE_URL=postgresql://pos_user:pos_pass@localhost:5432/pos_db
FLASK_APP=run.py
FLASK_ENV=development

# Backup directory (relative to backend/ or absolute path)
# BACKUP_DIR=backups

# Optional USB mount/path. When it exists, backups are copied to
# USB_BACKUP_DIR\pos-system-backups.
# USB_BACKUP_DIR=E:\
