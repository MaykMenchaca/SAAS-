# POS System Backend Configuration
# Copy this file to .env and adjust values

SECRET_KEY=cambiar-en-produccion-usar-valor-aleatorio
JWT_SECRET_KEY=cambiar-en-produccion-usar-valor-aleatorio
DATABASE_URL=postgresql://pos_user:pos_pass@localhost:5432/pos_db
FLASK_APP=run.py

# PostgreSQL binaries directory (optional, autodetected in C:\Program Files\PostgreSQL\*\bin)
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin

# Application Timezone
APP_TIMEZONE=America/Mexico_City

# Production local mode
SERVE_FRONTEND=false
# FRONTEND_DIST=C:\ruta\al\pos-system\frontend\dist

# Gunicorn settings for Linux service deployment
# GUNICORN_BIND=0.0.0.0:5000
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2

# Backup directory (defaults to %PROGRAMDATA%\pos-vrntas\backups on Windows or outside repo)
# BACKUP_DIR=C:\ProgramData\pos-vrntas\backups

# Optional USB mount/path. When it exists, backups are copied to
# USB_BACKUP_DIR\pos-system-backups.
# USB_BACKUP_DIR=E:\

# Business details
# BUSINESS_NAME=Mi Tienda POS
# BUSINESS_RFC=XAXX010101000
# BUSINESS_ADDRESS=Av. Principal #123
# BUSINESS_PHONE=555-123-4567

# Receipt Printer Configuration
# PRINTER_PATH=COM1
# PRINTER_BAUDRATE=9600

